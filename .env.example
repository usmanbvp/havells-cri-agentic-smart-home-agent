# Groq is primary; Gemini is the automatic secondary provider.
# Get keys from https://console.groq.com/keys and https://aistudio.google.com/apikey.
LLM_PRIMARY_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Retry transient errors once; respect short Retry-After values and fail over
# immediately when the provider quota reset is farther away.
LLM_MAX_RETRIES=1
LLM_TIMEOUT_SECONDS=45
LLM_RETRY_BACKOFF_SECONDS=0.5

# Use a supported IANA timezone for time-conditioned rules.
SMART_HOME_TIMEZONE=Asia/Kolkata
SMART_HOME_DB_PATH=data/smart_home.sqlite3
